# Fast source patch on top of this machine's already audited, source-built image.
# A clean build with deploy/security/Dockerfile is the portable alternative.
FROM local/we-mp-rss:source-9fd4edb-hardened

COPY --chown=10001:10001 core/content_images.py /app/core/content_images.py
COPY --chown=10001:10001 core/rss.py /app/core/rss.py
COPY --chown=10001:10001 tools/fix.py /app/tools/fix.py

USER 10001:10001
